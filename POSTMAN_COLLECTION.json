{
    "info": {
        "name": "M&N Grocery Store - Inventory API",
        "description": "Complete API collection for FoodAisle Inventory Management System",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@foodaisle.com\",\n  \"password\": \"admin123\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/auth/login",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Current User",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:5000/api/auth/me",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "auth",
                                "me"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Products",
            "item": [
                {
                    "name": "Get All Products",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:5000/api/products",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "products"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Products with Stock",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:5000/api/products/with-stock",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "products",
                                "with-stock"
                            ]
                        }
                    }
                },
                {
                    "name": "Create Product",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Product Name\",\n  \"barcode\": \"1234567890123\",\n  \"price\": \"10.99\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"supplierId\": \"{{supplierId}}\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/products",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "products"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Stock Management",
            "item": [
                {
                    "name": "Record Stock Movement",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 10,\n  \"type\": \"STOCK_IN\",\n  \"notes\": \"Restocking from supplier\"\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/stock",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "stock"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Suppliers",
            "item": [
                {
                    "name": "Get All Suppliers",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:5000/api/suppliers",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "suppliers"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Purchase Orders",
            "item": [
                {
                    "name": "Create Purchase Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 50\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/purchase-orders",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "purchase-orders"
                            ]
                        }
                    }
                },
                {
                    "name": "Complete Purchase Order",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"receivedQty\": 50\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "http://localhost:5000/api/purchase-orders/{{orderId}}/complete",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5000",
                            "path": [
                                "api",
                                "purchase-orders",
                                "{{orderId}}",
                                "complete"
                            ]
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "categoryId",
            "value": ""
        },
        {
            "key": "supplierId",
            "value": ""
        },
        {
            "key": "productId",
            "value": ""
        },
        {
            "key": "orderId",
            "value": ""
        }
    ]
}